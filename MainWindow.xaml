<Window x:Class="NCHops.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:NCHops"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="NC Studio" WindowState="Maximized"
        Width="1200" Height="700"
        Icon="icon.ico"
        Background="#d8e0ea"
        PreviewKeyDown="OnWindowKeyDown"
        Closing="OnWindowClosing">
    <Window.Resources>

        <!-- ── Farb-Ressourcen ────────────────────────────────────── -->
        <SolidColorBrush x:Key="AccentBrush"       Color="#DDD0B0"/>
        <SolidColorBrush x:Key="AccentHoverBrush"  Color="#E6DBBF"/>
        <SolidColorBrush x:Key="AccentPressBrush"  Color="#CEC09E"/>
        <SolidColorBrush x:Key="AccentTintBrush"   Color="#FCF9F2"/>
        <SolidColorBrush x:Key="BgBrush"           Color="#d8e0ea"/>
        <SolidColorBrush x:Key="BgLightBrush"      Color="#eaecf2"/>
        <SolidColorBrush x:Key="BgDarkBrush"       Color="#c0cad6"/>
        <SolidColorBrush x:Key="BorderBrush"       Color="#a8b4c0"/>
        <SolidColorBrush x:Key="TextDarkBrush"     Color="#6A5430"/>
        <SolidColorBrush x:Key="TextOnAccentBrush" Color="#3A2C10"/>

        <local:UnitValueConverter x:Key="UC"/>

        <!-- ── Button ─────────────────────────────────────────────── -->
        <Style TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentPressBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource AccentPressBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background"  Value="#EDE6D5"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#776655"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox ────────────────────────────────────────────── -->
        <Style TargetType="TextBox">
            <Setter Property="Background"             Value="{StaticResource BgLightBrush}"/>
            <Setter Property="Foreground"             Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="BorderBrush"            Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="Padding"                Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <EventSetter Event="PreviewMouseLeftButtonDown"
                         Handler="TextBox_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="GotKeyboardFocus"
                         Handler="TextBox_GotKeyboardFocus"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NoSelectAllTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgLightBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── Label ──────────────────────────────────────────────── -->
        <Style TargetType="Label">
            <Setter Property="Foreground"           Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight"           Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── CheckBox ───────────────────────────────────────────── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- ── DataGrid ───────────────────────────────────────────── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"          Value="{StaticResource BgLightBrush}"/>
            <Setter Property="RowBackground"       Value="{StaticResource BgLightBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BgBrush}"/>
            <Setter Property="BorderBrush"         Value="{StaticResource BorderBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush"   Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground"          Value="{StaticResource TextDarkBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"   Value="{StaticResource TextOnAccentBrush}"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="6,4"/>
            <Setter Property="BorderBrush"  Value="{StaticResource AccentPressBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- ── ComboBox ───────────────────────────────────────────── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"  Value="{StaticResource BgLightBrush}"/>
            <Setter Property="Foreground"  Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>

        <!-- ── Werkzeugpalette-Buttons ───────────────────────────── -->
        <Style x:Key="ToolPalBtn" TargetType="Button">
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Margin"          Value="0,2"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Bezugspunkt-Radio (kompakt) für Seitenleiste ─────── -->
        <Style x:Key="BezugKompakt" TargetType="RadioButton">
            <Setter Property="Width"  Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Outer" Width="11" Height="11"
                                     Stroke="#8B7040" StrokeThickness="1.5" Fill="White"/>
                            <Ellipse x:Name="Inner" Width="5" Height="5"
                                     Fill="#9B7820" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Outer" Property="Fill"       Value="#F5EDD0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Fill" Value="#EAD8A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Separatoren & Array ────────────────────────────────── -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <x:Array x:Key="BezugListe" Type="{x:Type sys:String}">
            <sys:String>Unten links</sys:String>
            <sys:String>Oben links</sys:String>
            <sys:String>Unten rechts</sys:String>
            <sys:String>Oben rechts</sys:String>
            <sys:String>Mitte</sys:String>
            <sys:String>Links Mitte</sys:String>
            <sys:String>Rechts Mitte</sys:String>
            <sys:String>Oben Mitte</sys:String>
            <sys:String>Unten Mitte</sys:String>
        </x:Array>

    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">

        <DockPanel Background="Transparent">

        <!-- ── Menüleiste ───────────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource AccentBrush}"
              Foreground="{StaticResource TextOnAccentBrush}">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Role"          Value="TopLevelHeader"/>
                                <Condition Property="IsHighlighted" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
                <!-- Basis-Style für alle Menü-Icons -->
                <Style x:Key="MI" TargetType="TextBlock">
                    <Setter Property="FontSize"            Value="13"/>
                    <Setter Property="Width"               Value="16"/>
                    <Setter Property="TextAlignment"       Value="Center"/>
                    <Setter Property="VerticalAlignment"   Value="Center"/>
                    <Setter Property="Foreground"          Value="{StaticResource TextDarkBrush}"/>
                </Style>
            </Menu.Resources>

            <!-- Datei ─────────────────────────────────────── -->
            <MenuItem Header="Datei">
                <MenuItem Header="Bild öffnen..." Click="OnBildOeffnen">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}"
                                   FontFamily="Segoe MDL2 Assets" Text="&#xE8B4;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Speichern" Click="OnSpeichern">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}"
                                   FontFamily="Segoe MDL2 Assets" Text="&#xE74E;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Fräsen..." Click="OnFraesenSenden">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}"
                                   FontFamily="Segoe MDL2 Assets" Text="&#xE768;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="SVG exportieren..." Click="OnExportSvg">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}"
                                   FontFamily="Segoe MDL2 Assets" Text="&#xE8B1;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Werkstück">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="▭" FontSize="12"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Nullpunkt X, Y" Click="OnWerkstueckNullpunkt">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource MI}" Text="⊙" FontSize="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Nullpunkt Z">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource MI}" Text="↕" FontSize="13"/>
                        </MenuItem.Icon>
                        <MenuItem Header="Auf Werkstück (Standard)" x:Name="MnuNullpunktZWerkstueck"
                                  IsCheckable="True" IsChecked="True" Click="OnNullpunktZWerkstueck"/>
                        <MenuItem Header="Auf Maschinentisch" x:Name="MnuNullpunktZTisch"
                                  IsCheckable="True" Click="OnNullpunktZTisch"/>
                    </MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Beenden" Click="OnBeenden">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}"
                                   FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Fräsen ─────────────────────────────────────── -->
            <MenuItem Header="Fräsen">
                <!-- Planfräsen: flache Fläche -->
                <MenuItem Header="Planfräsen" Click="OnPlanfraesen">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="▬" FontSize="10"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Umfahren: Kontur (offenes Rechteck) -->
                <MenuItem Header="Umfahren" Click="OnUmfahren">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="▭" FontSize="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Nut: drei Linien = Schlitz -->
                <MenuItem Header="Nut" Click="OnNut">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="≡" FontSize="13"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Tasche: schraffiertes Rechteck = gefräste Vertiefung -->
                <MenuItem Header="Tasche" Click="OnTasche">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="▩" FontSize="11"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Kreistasche: Kreisziel = runde Vertiefung -->
                <MenuItem Header="Kreistasche" Click="OnKreistasche">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="◎" FontSize="13"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Zapfen: T-Form von oben = überstehender Steg -->
                <MenuItem Header="Zapfen" Click="OnPlanfraesen" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="⊤" FontSize="12"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Pfad Fräsen ─────────────────────────────────── -->
            <MenuItem Header="Pfad Fräsen">
                <!-- Startpunkt: Kreispunkt = Startposition -->
                <MenuItem Header="Startpunkt" Click="OnPfadStart">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="⊙" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Linie: kleiner Punkt = Linienpunkt -->
                <MenuItem Header="Linie" Click="OnPfadLinie" x:Name="MnuPfadLinie">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="●" FontSize="10"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Bogen: Bogensymbol -->
                <MenuItem Header="Bogen" Click="OnPfadBogen" x:Name="MnuPfadBogen">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="◜" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Spline: Wellenlinie = Spline -->
                <MenuItem Header="Spline" Click="OnPfadSpline" x:Name="MnuPfadSpline">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="∿" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Bohren ─────────────────────────────────────── -->
            <MenuItem Header="Bohren">
                <!-- Bohrung: Kreiskreuz = Bohrloch -->
                <MenuItem Header="Bohrung" Click="OnBohrung">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="⊕" FontSize="13"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Reihenlochbohrung: mehrere Punkte = Lochreihe -->
                <MenuItem Header="Reihenlochbohrung" Click="OnReihenlochbohrung">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="⁝⊕" FontSize="10" Width="20"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Gravieren ───────────────────────────────────── -->
            <MenuItem Header="Gravieren">
                <MenuItem Header="Textfeld A umriss" Click="OnGravieren">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="A" FontSize="13"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Textfeld A carve"  Click="OnVCarve">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="▲" FontSize="11"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Textfeld A Tasche" Click="OnTextfeldTasche">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="▬" FontSize="11"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Werkzeuge ──────────────────────────────────── -->
            <MenuItem Header="Werkzeuge">
                <MenuItem Header="Werkzeugliste..." Click="OnWerkzeugliste">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}"
                                   FontFamily="Segoe MDL2 Assets" Text="&#xE713;"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Ansicht ─────────────────────────────────────── -->
            <MenuItem Header="Ansicht">
                <MenuItem Header="Ansicht 100 %" Click="OnZoom100"
                          InputGestureText="Strg+0">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="①" FontSize="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Originalmaßstab 1:1" Click="OnZoom1to1"
                          InputGestureText="Strg+1">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}"
                                   FontFamily="Consolas" Text="1:1" FontSize="9"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Raster einblenden" x:Name="MnuRaster"
                          IsCheckable="True" IsChecked="True" Click="OnRasterEinblenden">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="⊞" FontSize="13"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="G-Code anzeigen" x:Name="MnuGCodeAnzeigen"
                          IsCheckable="True" IsChecked="True" Click="OnGCodeAnzeigen">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}"
                                   FontFamily="Consolas" Text="&lt;/&gt;" FontSize="9"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Fräsbreite simulieren" x:Name="MnuFraesbreite"
                          IsCheckable="True" Click="OnFraesbreiteAnzeigen">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="⬛" FontSize="10"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Berechnungen visualisieren" x:Name="MnuVCarveVisualisieren"
                          IsCheckable="True" Click="OnVCarveVisualisierenChanged">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}" Text="◎" FontSize="13"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Text-Editor Rendering..." Click="OnOpenTextEditorRendering">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}"
                                   FontFamily="Segoe MDL2 Assets" Text="&#xE245;"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Hilfe ──────────────────────────────────────── -->
            <MenuItem Header="Hilfe">
                <MenuItem Header="Info" Click="OnInfo">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MI}"
                                   FontFamily="Segoe MDL2 Assets" Text="&#xE946;"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ── Eingabebereich unten ─────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="0,2,0,0"
                Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Label Content="X:"/>
                <TextBox x:Name="TxtX" Text="800" Width="70" Margin="0,0,12,0"/>
                <Label Content="Y:"/>
                <TextBox x:Name="TxtY" Text="400" Width="70" Margin="0,0,12,0"/>
                <Label Content="Z:"/>
                <TextBox x:Name="TxtZ" Text="19"  Width="70" Margin="0,0,16,0"/>
                <Button Content="Aktualisieren" Click="OnAktualisieren" Margin="0,0,24,0"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                           Margin="0,0,16,0"/>
                <!--<CheckBox x:Name="CbPfadAnzeigen" Content="Pfad Fräsen anzeigen"
                          VerticalAlignment="Center" FontWeight="SemiBold"
                          Checked="OnPfadAnzeigenChanged" Unchecked="OnPfadAnzeigenChanged"/>-->
            </StackPanel>
        </Border>

        <!-- ── Pfad Fräsen Panel (deaktiviert) ─────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" x:Name="PfadPanel"
                Visibility="Collapsed" Height="0"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,2,0,0"
                Background="{StaticResource AccentTintBrush}">
            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Parameter-Zeile -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Label Content="Z-Tiefe:"     Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtZ"          Text="-5"    Width="55" Margin="0,0,10,0"/>
                    <Label Content="Zustellung:"  Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtZustellung" Text="3"     Width="45" Margin="0,0,10,0"/>
                    <Label Content="Vorschub:"    Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtVorschub"   Text="800"   Width="55" Margin="0,0,10,0"/>
                    <Label Content="Drehzahl:"    Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtDrehzahl"   Text="18000" Width="60" Margin="0,0,10,0"/>
                    <Label Content="Fräser D:"    Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtFraeserD"   Text="10"    Width="45" Margin="0,0,10,0"/>
                    <Label Content="Seite:" Padding="0,0,4,0"/>
                    <ComboBox x:Name="PfadCbSeite" SelectedIndex="1" Width="65"
                              VerticalAlignment="Center" Margin="0,0,10,0"
>
                        <ComboBoxItem Content="Links"/>
                        <ComboBoxItem Content="Mitte"/>
                        <ComboBoxItem Content="Rechts"/>
                    </ComboBox>
                    <Label Content="Standard-Bezug:" Padding="0,0,4,0"/>
                    <ComboBox x:Name="PfadCbBezug" SelectedIndex="0" Width="110"
                              VerticalAlignment="Center" Margin="0,0,16,0"
>
                        <ComboBoxItem Content="Unten links"/>
                        <ComboBoxItem Content="Oben links"/>
                        <ComboBoxItem Content="Unten rechts"/>
                        <ComboBoxItem Content="Oben rechts"/>
                        <ComboBoxItem Content="Mitte"/>
                        <ComboBoxItem Content="Links Mitte"/>
                        <ComboBoxItem Content="Rechts Mitte"/>
                        <ComboBoxItem Content="Oben Mitte"/>
                        <ComboBoxItem Content="Unten Mitte"/>
                    </ComboBox>
                    <Button Content="G-Code erzeugen" FontWeight="SemiBold"
                            Margin="0,0,16,0"/>
                    <Label Content="Schritt:" Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtSchritt" Text="5" Width="40"
                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Label Content="mm" Padding="0"/>
                </StackPanel>

                <!-- Liste + Eingabe -->
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Punktliste -->
                    <DataGrid Grid.Column="0" x:Name="PfadLvPunkte"
                              AutoGenerateColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              Margin="0,0,6,0"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr."    Width="38"  Binding="{Binding Nr}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="X (mm)" Width="60"  Binding="{Binding X, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Y (mm)" Width="60"  Binding="{Binding Y, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridComboBoxColumn Header="Bezug" Width="*"
                                SelectedItemBinding="{Binding Bezug, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{StaticResource BezugListe}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Eingabe + Buttons -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="X" Padding="0"/>
                            <TextBox Grid.Column="1" x:Name="PfadTxtX" Text="0"
                                     Margin="2,0,6,0" />
                            <Label Grid.Column="2" Content="Y" Padding="0"/>
                            <TextBox Grid.Column="3" x:Name="PfadTxtY" Text="0"
                                     Margin="2,0,0,0" />
                        </Grid>

                        <Button Grid.Row="1" Content="+ Hinzufügen"
                                Margin="0,0,0,6"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="↑"   Width="30" Margin="0,0,4,0"/>
                            <Button Content="↓"   Width="30" Margin="0,0,4,0"/>
                            <Button Content="✕"   Width="30" Margin="0,0,4,0"/>
                            <Button Content="Alle" Width="40"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Haupt-Splitter ────────────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"  MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <!-- Canvas mit Hintergrund-Icon + Simulationssteuerleiste -->
            <Grid Grid.Column="0" Background="{StaticResource BgLightBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Zeichenbereich -->
                <Grid x:Name="CanvasGrid" Grid.Row="0" ClipToBounds="True" Background="Transparent" ContextMenuOpening="OnCanvasContextMenuOpening">
                    <Grid.ContextMenu>
                        <ContextMenu x:Name="TemplateImageContextMenu">
                            <MenuItem Header="Drehen 90° CW" Click="OnTemplateRotateCW"/>
                            <MenuItem Header="Drehen 90° CCW" Click="OnTemplateRotateCCW"/>
                            <Separator/>
                            <MenuItem Header="Horizontal spiegeln" Click="OnTemplateFlipH"/>
                            <MenuItem Header="Vertikal spiegeln" Click="OnTemplateFlipV"/>
                            <Separator/>
                            <MenuItem Header="Bild entfernen" Click="OnTemplateRemove"/>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <!-- Wasserzeichen-Canvas: KEIN RenderTransform → zoom-invariant -->
                    <Canvas x:Name="WatermarkCanvas" IsHitTestVisible="False" Panel.ZIndex="0"/>
                    <!-- SkiaSharp Zeichenfläche: alle visuellen Inhalte, kein Hit-Test -->
                    <skia:SKElement x:Name="DrawSkia"
                                    IsHitTestVisible="False"
                                    Panel.ZIndex="1"/>
                    <!-- Hit-Canvas: transparente Klickflächen + Mouse-Events, gleiche Transform wie DrawSkia -->
                    <Canvas x:Name="HitCanvas"
                            Background="Transparent"
                            SizeChanged="OnCanvasSizeChanged"
                            Panel.ZIndex="2"/>
                    <!-- Simulations-Werkzeugkopf -->
                    <Canvas x:Name="SimToolCanvas" IsHitTestVisible="True" Panel.ZIndex="5"/>
                    <!-- Overlay für Vermassen-TextBox (hit-test aktiv, über allem) -->
                    <Canvas x:Name="VermOverlayCanvas" Panel.ZIndex="6" Background="Transparent"
                            IsHitTestVisible="True"/>
                    <!-- Werkzeugpalette (links, schwebend) -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="8,0" Padding="4,6"
                            Background="#CC2A3545" CornerRadius="6"
                            Panel.ZIndex="8">
                        <StackPanel>
                            <Button x:Name="BtnToolHand"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnToolHand"
                                    ToolTip="Hand (H) – Bild verschieben">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="White" Stretch="Uniform"
                                          Data="M23 5.5V20c0 2.2-1.8 4-4 4h-7.3c-1.08 0-2.1-.43-2.85-1.19L1 14.83s1.26-1.23 1.3-1.25c.22-.19.49-.29.79-.29.22 0 .42.06.6.16L7 15.66V6c0-.83.67-1.5 1.5-1.5S10 5.17 10 6v5h1V3.5c0-.83.67-1.5 1.5-1.5S14 2.67 14 3.5V11h1V4.5c0-.83.67-1.5 1.5-1.5S18 3.67 18 4.5V11h1V5.5c0-.83.67-1.5 1.5-1.5S23 4.67 23 5.5z"/>
                                </Viewbox>
                            </Button>
                            <Button x:Name="BtnToolZoom"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnToolZoom"
                                    ToolTip="Zoom (Z) – Klick=rein  Rechtsklick=raus">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71E;"
                                           FontSize="17" Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnToolWerkzeugWechsel"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnToolWerkzeugWechsel"
                                    ToolTip="Werkzeug wechsel – aktives Werkzeug wählen">
                                <TextBlock Text="🔧" FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnToolVCarveTextSk"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnToolVCarveTextSk"
                                    ToolTip="V-Carve Textfeld aufziehen (Skia – schneller)">
                                <TextBlock Text="T" FontSize="13" Foreground="White"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnToolMove"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnToolMove"
                                    ToolTip="Verschieben – ganzen Pfad / Objekte verschieben">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="White" Stretch="None"
                                          Data="M 8,0 L 10.5,4 L 9,4 L 9,7 L 12,7 L 12,9 L 9,9 L 9,12 L 10.5,12 L 8,16 L 5.5,12 L 7,12 L 7,9 L 4,9 L 4,7 L 7,7 L 7,4 L 5.5,4 Z"/>
                                </Viewbox>
                            </Button>
                            <Button x:Name="BtnToolPfeil"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnToolPfeil"
                                    ToolTip="Pfeilwerkzeug – einzelne Pfad-Punkte verschieben">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="White" Stretch="None"
                                          Data="M 1,1 L 1,11 L 4,8 L 5.5,12 L 7,11.5 L 5.5,7.5 L 9,7.5 Z"/>
                                </Viewbox>
                            </Button>
                            <Button x:Name="BtnToolVermassen"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnToolVermassen"
                                    ToolTip="Vermassen – Maßlinie an Pfad-Segment">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="White" Stretch="None"
                                          Data="M 1,12 L 15,12 M 1,10 L 1,14 M 15,10 L 15,14 M 8,12 L 8,4 M 5,6 L 8,2 L 11,6"/>
                                </Viewbox>
                            </Button>
                            <Rectangle Height="1" Margin="4,6" Fill="#44FFFFFF"/>
                            <Button x:Name="BtnToolPfadStart"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnPfadStart"
                                    ToolTip="Pfad-Startpunkt">
                                <TextBlock Text="⊙" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnToolPfadLinie"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnPfadLinie"
                                    IsEnabled="False"
                                    ToolTip="Pfad-Linie">
                                <TextBlock Text="╌" FontSize="14" Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnToolPfadKurve"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnPfadBogen"
                                    IsEnabled="False"
                                    ToolTip="Pfad-Kurve (Bogen)">
                                <TextBlock Text="◜" FontSize="15" Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnToolPfadSpline"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnPfadSpline"
                                    IsEnabled="False"
                                    ToolTip="Pfad-Spline">
                                <TextBlock Text="∿" FontSize="14" Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                            <Rectangle Height="1" Margin="4,6" Fill="#44FFFFFF"/>
                            <Button x:Name="BtnToolRechteck"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnRechteckTool"
                                    ToolTip="Rechteck aufziehen">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="White" Stretch="None"
                                          Data="M 1,1 L 15,1 L 15,11 L 1,11 Z"/>
                                </Viewbox>
                            </Button>
                            <Button x:Name="BtnToolKreis"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnKreisTool"
                                    ToolTip="Kreis aufziehen">
                                <Viewbox Width="16" Height="16">
                                    <Ellipse Width="14" Height="14" Margin="1"
                                             Stroke="White" StrokeThickness="1.5" Fill="Transparent"/>
                                </Viewbox>
                            </Button>
                            <Button x:Name="BtnToolNEck"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnNEckTool"
                                    ToolTip="N-Eck (Polygon) aufziehen">
                                <Viewbox Width="16" Height="16">
                                    <Polygon Points="8,1 14,4 12,12 4,14 2,6"
                                             Stroke="White" StrokeThickness="1.5" Fill="Transparent"/>
                                </Viewbox>
                            </Button>
                            <Button x:Name="BtnToolReihenloch"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnReihenlochTool"
                                    ToolTip="Reihenlochbohrung – Klick = Bohrung, Anker = verschieben, Pfeile ziehen = weitere Löcher">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="16" Height="16">
                                        <Ellipse Canvas.Left="1"  Canvas.Top="10" Width="5" Height="5" Stroke="White" StrokeThickness="1.3"/>
                                        <Ellipse Canvas.Left="10" Canvas.Top="10" Width="5" Height="5" Stroke="White" StrokeThickness="1.3"/>
                                        <Ellipse Canvas.Left="1"  Canvas.Top="1"  Width="5" Height="5" Stroke="White" StrokeThickness="1.3"/>
                                        <Ellipse Canvas.Left="10" Canvas.Top="1"  Width="5" Height="5" Stroke="White" StrokeThickness="1.3"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- Vermassen-Toolbar (rechts, schwebend, nur sichtbar wenn Vermassen aktiv) -->
                    <Border x:Name="VermToolbar"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0" Padding="4,6"
                            Background="#CC2A3545" CornerRadius="6"
                            Panel.ZIndex="8" Visibility="Collapsed">
                        <StackPanel>
                            <!-- Koinzident -->
                            <Button x:Name="BtnVermKoinzident"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnVermKoinzident"
                                    ToolTip="Koinzident – zwei Punkte auf gleiche Position zwingen">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="16" Height="16">
                                        <Ellipse Canvas.Left="1" Canvas.Top="1" Width="6" Height="6"
                                                 Stroke="White" StrokeThickness="1.5" Fill="Transparent"/>
                                        <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                                                 Stroke="White" StrokeThickness="1.5" Fill="Transparent"/>
                                        <Line X1="4" Y1="4" X2="12" Y2="12"
                                              Stroke="White" StrokeThickness="1" Opacity="0.5"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Rechtwinklig -->
                            <Button x:Name="BtnVermRechtwinklig"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnVermRechtwinklig"
                                    ToolTip="Rechtwinklig – zwei Linien senkrecht zueinander, oder Linie senkrecht zur Werkstückkante (2. Klick auf Kante)">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="16" Height="16">
                                        <Line X1="2" Y1="14" X2="14" Y2="14"
                                              Stroke="White" StrokeThickness="1.5"/>
                                        <Line X1="2" Y1="14" X2="2" Y2="2"
                                              Stroke="White" StrokeThickness="1.5"/>
                                        <Polyline Points="2,8 6,8 6,14"
                                                  Stroke="White" StrokeThickness="1" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Parallel -->
                            <Button x:Name="BtnVermParallel"
                                    Style="{StaticResource ToolPalBtn}"
                                    Click="OnVermParallel"
                                    ToolTip="Parallel – zwei Linien parallel halten, oder Linie parallel zur Werkstückkante (2. Klick auf Kante)">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="16" Height="16">
                                        <Line X1="2" Y1="5"  X2="14" Y2="5"
                                              Stroke="White" StrokeThickness="1.5"/>
                                        <Line X1="2" Y1="11" X2="14" Y2="11"
                                              Stroke="White" StrokeThickness="1.5"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Zoom-Anzeige -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,6,6" Padding="5,2"
                            Background="#99000000" CornerRadius="3"
                            IsHitTestVisible="False" Panel.ZIndex="10">
                        <TextBlock x:Name="TxtZoomLevel"
                                   Text="100 %" Foreground="White"
                                   FontSize="11" FontFamily="Consolas"/>
                    </Border>
                </Grid>

                <!-- Simulationssteuerleiste -->
                <Border Grid.Row="1"
                        Background="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentPressBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnSimPlay" Grid.Column="0"
                                Content="▶" Width="28" Height="22" Padding="0"
                                Click="OnSimPlay" ToolTip="Simulieren abspielen / pausieren"/>
                        <Button x:Name="BtnSimStop" Grid.Column="1"
                                Content="■" Width="28" Height="22" Padding="0"
                                Margin="4,0,0,0" Click="OnSimStop" ToolTip="Simulation zurücksetzen"/>
                        <Slider x:Name="SimSlider" Grid.Column="2"
                                Margin="8,0" Minimum="0" Maximum="1" Value="0"
                                VerticalAlignment="Center"
                                ValueChanged="OnSimSliderChanged"
                                MouseDown="OnSimSliderMouseDown"
                                MouseUp="OnSimSliderMouseUp"/>
                        <TextBlock x:Name="TxtSimPos" Grid.Column="3"
                                   Text="0 mm" VerticalAlignment="Center"
                                   Margin="6,0,4,0" FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource TextOnAccentBrush}"
                                   MinWidth="60"/>
                        <ComboBox x:Name="CbSimSpeed" Grid.Column="4"
                                  Width="52" Height="22" FontSize="11"
                                  SelectedIndex="0" SelectionChanged="OnSimSpeedChanged">
                            <ComboBoxItem Content="1×"/>
                            <ComboBoxItem Content="2×"/>
                            <ComboBoxItem Content="5×"/>
                            <ComboBoxItem Content="10×"/>
                        </ComboBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource AccentBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- G-Code / Verlauf Register -->
            <TabControl Grid.Column="2"
                        Background="{StaticResource BgLightBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        Padding="0"
                        SelectionChanged="OnTabSelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="10,4"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                    </Style>
                </TabControl.Resources>

                <!-- Tab 1: Verlauf -->
                <TabItem Header="Verlauf">
                    <Grid Background="{StaticResource BgLightBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="HistoryList"
                                 Grid.Row="0"
                                 Background="{StaticResource BgLightBrush}"
                                 BorderThickness="0"
                                 Padding="4"
                                 SelectionMode="Extended"
                                 MouseDoubleClick="OnHistoryDoubleClick"
                                 PreviewMouseRightButtonDown="OnHistoryRightClick"
                                 PreviewKeyDown="OnHistoryKeyDown"
                                 SelectionChanged="OnHistorySelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"         Value="8,6"/>
                                    <Setter Property="Margin"          Value="0,2"/>
                                    <Setter Property="Background"      Value="{StaticResource BgBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor"          Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <!-- Sub-Einträge (Linie / Bogen): linker Balken + engere Abstände -->
                                        <DataTrigger Binding="{Binding Level}" Value="1">
                                            <Setter Property="Padding"         Value="22,3,8,3"/>
                                            <Setter Property="Margin"          Value="0,0"/>
                                            <Setter Property="Background"      Value="{StaticResource BgLightBrush}"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                            <Setter Property="BorderBrush"     Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Einklapp-Pfeil (nur für Pfad-Startpunkte) -->
                                        <Button x:Name="BtnCollapse"
                                                Grid.Column="0"
                                                Content="▼"
                                                Visibility="Collapsed"
                                                Click="OnHistoryToggleCollapse"
                                                Width="18" Height="18"
                                                FontSize="9"
                                                Padding="0"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource AccentBrush}"
                                                Cursor="Hand"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="LblLabel"
                                                       Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock x:Name="LblDetails"
                                                       Text="{Binding Details}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextDarkBrush}"
                                                       Opacity="0.75"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsExpandable}" Value="True">
                                            <Setter TargetName="BtnCollapse" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <Setter TargetName="BtnCollapse" Property="Content" Value="▶"/>
                                        </DataTrigger>
                                        <!-- Sub-Einträge: kleineres, normales Label -->
                                        <DataTrigger Binding="{Binding Level}" Value="1">
                                            <Setter TargetName="LblLabel"   Property="FontSize"   Value="11"/>
                                            <Setter TargetName="LblLabel"   Property="FontWeight" Value="Normal"/>
                                            <Setter TargetName="LblLabel"   Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                                            <Setter TargetName="LblDetails" Property="FontSize"   Value="10"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="1" Margin="4,4,4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Doppelklick = Bearbeiten · Rechtsklick = Menü"
                                       FontSize="10" Opacity="0.5"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                                <Button Content="↑" Width="26" Height="22" FontSize="12"
                                        ToolTip="Nach oben (Alt+↑)"
                                        Click="OnHistoryMoveUp" Margin="0,0,2,0"/>
                                <Button Content="↓" Width="26" Height="22" FontSize="12"
                                        ToolTip="Nach unten (Alt+↓)"
                                        Click="OnHistoryMoveDown"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Eigenschaften (Gravieren) -->
                <TabItem Header="Eigenschaften" x:Name="TabEigenschaften">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource BgLightBrush}">
                        <StackPanel Margin="10" x:Name="EigPanel">

                            <TextBlock x:Name="TbEigKein"
                                       Text="Kein Gravieren-Eintrag ausgewählt."
                                       Foreground="{StaticResource TextDarkBrush}"
                                       Opacity="0.5" TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <StackPanel x:Name="PnlGravieren" Visibility="Collapsed">

                                <TextBlock Text="Text:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="EigText"
                                         AcceptsReturn="True" Height="60"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         Margin="0,0,0,6"
                                         TextChanged="OnEigTextDirty"/>
                                <Button x:Name="BtnGCodeBerechnen"
                                        Content="G-Code berechnen"
                                        Margin="0,0,0,10"
                                        Click="OnGCodeBerechnen"/>


                                <TextBlock Text="Bezugspunkt:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="EigBezugspunkt" Margin="0,0,0,6"
                                          SelectionChanged="OnEigFontChanged">
                                    <ComboBoxItem Content="Unten links"/>
                                    <ComboBoxItem Content="Oben links"/>
                                    <ComboBoxItem Content="Unten rechts"/>
                                    <ComboBoxItem Content="Oben rechts"/>
                                    <ComboBoxItem Content="Links Mitte"/>
                                    <ComboBoxItem Content="Rechts Mitte"/>
                                    <ComboBoxItem Content="Oben Mitte"/>
                                    <ComboBoxItem Content="Unten Mitte"/>
                                    <ComboBoxItem Content="Mitte"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EigXRel" TextChanged="OnEigSizeChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EigYRel" TextChanged="OnEigSizeChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Feldbreite (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EigTextBreite" TextChanged="OnEigSizeChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Feldhöhe (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EigTextHoehe" TextChanged="OnEigSizeChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Schriftart:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="EigFont" IsEditable="True"
                                                  SelectionChanged="OnEigFontChanged"
                                                  KeyUp="OnEigFontKeyUp"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Schriftgröße (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EigFontSize" TextChanged="OnEigSizeChanged" PreviewKeyDown="OnEigFontSizeKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Zeichenabstand (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EigTracking" TextChanged="OnEigTrackingLineHeightChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Zeilenabstand (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EigLineHeight" TextChanged="OnEigTrackingLineHeightChanged"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 9-Punkt Ausrichtung: Horizontal + Vertikal -->
                                <TextBlock Text="Text-Ausrichtung (9-Punkt):" FontWeight="SemiBold" Margin="0,0,0,6"/>

                                <!-- Horizontal Alignment -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Horizontal:" FontWeight="Normal"
                                               VerticalAlignment="Center" Margin="0,0,8,0" Width="70"/>
                                    <RadioButton x:Name="EigAusrLinks"  Content="Links"  GroupName="HAlignmentGroup"
                                                 IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Checked="OnEigAusrichtungChanged"/>
                                    <RadioButton x:Name="EigAusrMitte"  Content="Mitte" GroupName="HAlignmentGroup"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Checked="OnEigAusrichtungChanged"/>
                                    <RadioButton x:Name="EigAusrRechts" Content="Rechts" GroupName="HAlignmentGroup"
                                                 VerticalAlignment="Center"
                                                 Checked="OnEigAusrichtungChanged"/>
                                </StackPanel>

                                <!-- Vertical Alignment -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Vertikal:" FontWeight="Normal"
                                               VerticalAlignment="Center" Margin="0,0,8,0" Width="70"/>
                                    <RadioButton x:Name="EigAusrOben"  Content="Oben"  GroupName="VAlignmentGroup"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Checked="OnEigAusrichtungChanged"/>
                                    <RadioButton x:Name="EigAusrVMitte"  Content="Mitte" GroupName="VAlignmentGroup"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Checked="OnEigAusrichtungChanged"/>
                                    <RadioButton x:Name="EigAusrUnten" Content="Unten" GroupName="VAlignmentGroup"
                                                 IsChecked="True" VerticalAlignment="Center"
                                                 Checked="OnEigAusrichtungChanged"/>
                                </StackPanel>

                                <!-- Text-Darstellung (Fill/Stroke) -->
                                <TextBlock Text="Text-Darstellung:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="EigTextFill" Content="Fill" GroupName="TextStyleGroup"
                                                 IsChecked="True" Margin="0,0,15,0" VerticalAlignment="Center"
                                                 Checked="OnEigTextStyleChanged"/>
                                    <RadioButton x:Name="EigTextStroke" Content="Stroke" GroupName="TextStyleGroup"
                                                 VerticalAlignment="Center"
                                                 Checked="OnEigTextStyleChanged"/>
                                </StackPanel>

                                <!-- Stroke-Dicke Slider -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Stroke-Breite:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="EigStrokeWidth" Grid.Column="1" Minimum="0.1" Maximum="3" Value="1.3"
                                            ValueChanged="OnEigStrokeWidthChanged" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="EigStrokeWidthLabel" Grid.Column="2" Text="1.3" VerticalAlignment="Center" FontSize="11"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="↔ H. einmitten" Padding="6,3"
                                            Margin="0,0,6,0" Click="OnHorizEinmitten"/>
                                    <Button Content="↕ V. einmitten" Padding="6,3"
                                            Click="OnVertEinmitten"/>
                                </StackPanel>

                                <!-- V-Carve-spezifische Felder -->
                                <StackPanel x:Name="PnlVCarveEig" Visibility="Collapsed" Margin="0,2,0,0">
                                    <Separator Margin="0,2,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Max. Tiefe (mm):" FontWeight="SemiBold"
                                                       Margin="0,0,0,3" TextWrapping="Wrap" FontSize="11"/>
                                            <TextBox x:Name="EigMaxTiefe" TextChanged="OnEigSizeChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                            <TextBlock Text="Auflösung (mm):" FontWeight="SemiBold"
                                                       Margin="0,0,0,3" TextWrapping="Wrap" FontSize="11"/>
                                            <TextBox x:Name="EigAufloesung" TextChanged="OnEigSizeChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock Text="Spitzentol. (mm):" FontWeight="SemiBold"
                                                       Margin="0,0,0,3" TextWrapping="Wrap" FontSize="11"/>
                                            <TextBox x:Name="EigSpitzenTol" TextChanged="OnEigSizeChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Text zu Liniensegmente Button -->
                                    <Separator Margin="0,8,0,8"/>
                                    <Button x:Name="BtnTextToLineSegments"
                                            Content="Text zu Liniensegmenten konvertieren"
                                            Padding="8,6" Margin="0,0,0,0"
                                            Background="#0e639c"
                                            Foreground="White"
                                            Click="OnConvertTextToLineSegments"
                                            FontSize="11"
                                            ToolTip="Konvertiert den aktuellen Text in Liniensegmente für CNC-Bearbeitung"/>
                                    <TextBlock x:Name="TbTextConversionInfo"
                                               Foreground="#888" FontSize="10" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Height="0"/>
                                </StackPanel>

                                <TextBlock x:Name="TbEigInfo"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Pfad Fräsen – Punkt-Eigenschaften (Start / Linie / Bogen) -->
                            <StackPanel x:Name="PnlPfadStart" Visibility="Collapsed">

                                <TextBlock x:Name="PfadEigTitel" FontWeight="Bold"
                                           FontSize="13" Margin="0,0,0,8"
                                           Foreground="{StaticResource TextDarkBrush}"/>

                                <!-- Nur für Startpunkt: Werkzeug, Z, Radiuskorrektur -->
                                <StackPanel x:Name="PnlPfadEigStartOnly">
                                    <TextBlock Text="Z-Tiefe (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="PfadEigZ" Margin="0,0,0,10"
                                             LostFocus="OnPfadEigLostFocus"
                                             TextChanged="OnPfadEigTextChanged"/>
                                    <TextBlock Text="Radiuskorrektur:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="PfadEigRadius" Margin="0,0,0,10"
                                              SelectionChanged="OnPfadEigSelChanged">
                                        <ComboBoxItem Content="Links (G41)"/>
                                        <ComboBoxItem Content="Mittig"/>
                                        <ComboBoxItem Content="Rechts (G42)"/>
                                    </ComboBox>
                                </StackPanel>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PfadEigX" LostFocus="OnPfadEigLostFocus"
                                                 TextChanged="OnPfadEigTextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PfadEigY" LostFocus="OnPfadEigLostFocus"
                                                 TextChanged="OnPfadEigTextChanged"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Nur für Bogen: Mittelpunkt / Radius / Pfeilhöhe -->
                                <StackPanel x:Name="PnlPfadEigBogenMid">
                                    <TextBlock Text="Bogen-Art:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="PfadEigBogenModus" Margin="0,0,0,6"
                                              SelectionChanged="OnPfadEigBogenModusChanged">
                                        <ComboBoxItem Content="Bogenmitte"/>
                                        <ComboBoxItem Content="Radius"/>
                                        <ComboBoxItem Content="Pfeilhöhe"/>
                                    </ComboBox>
                                    <TextBlock x:Name="PfadEigBogenWertLabel"
                                               Text="Bogen-Mitte X (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="PfadEigXMid" Margin="0,0,0,6"
                                             LostFocus="OnPfadEigLostFocus"
                                             TextChanged="OnPfadEigTextChanged"/>
                                    <StackPanel x:Name="PnlPfadEigYMid">
                                        <TextBlock Text="Bogen-Mitte Y (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PfadEigYMid" Margin="0,0,0,6"
                                                 LostFocus="OnPfadEigLostFocus"
                                                 TextChanged="OnPfadEigTextChanged"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PfadEigBogenHinweis"
                                               Text="Vorzeichen: + = links, − = rechts (Fahrtrichtung)"
                                               FontSize="10" Foreground="#888" TextWrapping="Wrap"
                                               Margin="0,0,0,6" Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel x:Name="PnlPfadEigBezug">
                                    <TextBlock Text="Bezugspunkt:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="PfadEigBezug" Margin="0,0,0,6"
                                              SelectionChanged="OnPfadEigSelChanged">
                                        <ComboBoxItem Content="Letzter Punkt"/>
                                        <ComboBoxItem Content="Unten links"/>
                                        <ComboBoxItem Content="Oben links"/>
                                        <ComboBoxItem Content="Unten rechts"/>
                                        <ComboBoxItem Content="Oben rechts"/>
                                        <ComboBoxItem Content="Mitte"/>
                                        <ComboBoxItem Content="Links Mitte"/>
                                        <ComboBoxItem Content="Rechts Mitte"/>
                                        <ComboBoxItem Content="Oben Mitte"/>
                                        <ComboBoxItem Content="Unten Mitte"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Verrundung: nur für Linie und Bogen sichtbar -->
                                <StackPanel x:Name="PnlPfadEigVerrundung">
                                    <TextBlock Text="Verrundung (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="PfadEigVer" Margin="0,0,0,6"
                                             LostFocus="OnPfadEigLostFocus"
                                             TextChanged="OnPfadEigTextChanged"
                                             KeyDown="OnPfadEigKeyDown"/>
                                </StackPanel>

                                <!-- Spline: Segmentlänge und Fertig-Button -->
                                <StackPanel x:Name="PnlPfadEigSpline" Visibility="Collapsed">
                                    <TextBlock Text="Segmentlänge (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="PfadEigSplineSegmentLen" Text="0.5" Margin="0,0,0,10"
                                             LostFocus="OnPfadEigLostFocus"
                                             TextChanged="OnPfadEigTextChanged"/>
                                    <Button Content="Spline fertig" Click="OnSplineFinish" Margin="0,0,0,6"/>
                                </StackPanel>

                            </StackPanel>

                            <!-- Pfad geschlossen: Endpunkt-Eigenschaften (nur sichtbar wenn Start gewählt + Pfad geschlossen) -->
                            <StackPanel x:Name="PnlPfadEndPunkt" Visibility="Collapsed" Margin="0,8,0,0">

                                <Separator Margin="0,0,0,8"/>

                                <TextBlock x:Name="EndPfadEigTitel" Text="Endpunkt (Pfad geschlossen)"
                                           FontWeight="Bold" FontSize="13" Margin="0,0,0,8"
                                           Foreground="{StaticResource TextDarkBrush}"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EndPfadEigX" LostFocus="OnEndPfadEigLostFocus"
                                                 TextChanged="OnEndPfadEigTextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EndPfadEigY" LostFocus="OnEndPfadEigLostFocus"
                                                 TextChanged="OnEndPfadEigTextChanged"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Nur für Bogen-Endpunkt -->
                                <StackPanel x:Name="PnlEndPfadEigBogenMid">
                                    <TextBlock Text="Bogen-Art:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="EndPfadEigBogenModus" Margin="0,0,0,6"
                                              SelectionChanged="OnEndPfadEigBogenModusChanged">
                                        <ComboBoxItem Content="Bogenmitte"/>
                                        <ComboBoxItem Content="Radius"/>
                                        <ComboBoxItem Content="Pfeilhöhe"/>
                                    </ComboBox>
                                    <TextBlock x:Name="EndPfadEigBogenWertLabel"
                                               Text="Bogen-Mitte X (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="EndPfadEigXMid" Margin="0,0,0,6"
                                             LostFocus="OnEndPfadEigLostFocus"
                                             TextChanged="OnEndPfadEigTextChanged"/>
                                    <StackPanel x:Name="PnlEndPfadEigYMid">
                                        <TextBlock Text="Bogen-Mitte Y (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EndPfadEigYMid" Margin="0,0,0,6"
                                                 LostFocus="OnEndPfadEigLostFocus"
                                                 TextChanged="OnEndPfadEigTextChanged"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Bezugspunkt für Endpunkt: nicht mehr nötig (immer "Unten links") -->

                                <StackPanel x:Name="PnlEndPfadEigVerrundung">
                                    <TextBlock Text="Verrundung (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="EndPfadEigVer" Margin="0,0,0,6"
                                             LostFocus="OnEndPfadEigLostFocus"
                                             TextChanged="OnEndPfadEigTextChanged"
                                             KeyDown="OnEndPfadEigKeyDown"/>
                                </StackPanel>

                            </StackPanel>

                            <!-- Rechteck Fräsen – Eigenschaften -->
                            <StackPanel x:Name="PnlRechteck" Visibility="Collapsed">

                                <TextBlock Text="Rechteck" FontWeight="Bold" FontSize="13"
                                           Margin="0,0,0,8"
                                           Foreground="{StaticResource TextDarkBrush}"/>

                                <!-- Modus: Kontur / Tasche -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="RktModusNut" Content="Kontur"
                                                 GroupName="RktModus" IsChecked="True"
                                                 Margin="0,0,12,0" VerticalAlignment="Center"
                                                 Checked="OnRktEigChanged"/>
                                    <RadioButton x:Name="RktModusTasche" Content="Tasche"
                                                 GroupName="RktModus"
                                                 VerticalAlignment="Center"
                                                 Checked="OnRktEigChanged"/>
                                </StackPanel>

                                <!-- X / Y -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RktEigX" LostFocus="OnRktEigLostFocus" KeyDown="OnRktEigKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RktEigY" LostFocus="OnRktEigLostFocus" KeyDown="OnRktEigKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Bezugspunkt (kompakt) -->
                                <TextBlock Text="Bezugspunkt:" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Canvas Width="90" Height="64" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <Rectangle Canvas.Left="10" Canvas.Top="8"
                                               Width="70" Height="48"
                                               Fill="#F5EFDA" Stroke="#C8A864"
                                               StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>
                                    <!-- Oben -->
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="RktBezugOL"
                                                 GroupName="RktBezug" Canvas.Left="3"  Canvas.Top="1"
                                                 ToolTip="Oben links"  Checked="OnRktEigChanged"/>
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="RktBezugOM"
                                                 GroupName="RktBezug" Canvas.Left="38" Canvas.Top="1"
                                                 ToolTip="Oben Mitte"  Checked="OnRktEigChanged"/>
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="RktBezugOR"
                                                 GroupName="RktBezug" Canvas.Left="73" Canvas.Top="1"
                                                 ToolTip="Oben rechts" Checked="OnRktEigChanged"/>
                                    <!-- Mitte -->
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="RktBezugML"
                                                 GroupName="RktBezug" Canvas.Left="3"  Canvas.Top="25"
                                                 ToolTip="Links Mitte"  Checked="OnRktEigChanged"/>
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="RktBezugMM"
                                                 GroupName="RktBezug" Canvas.Left="38" Canvas.Top="25"
                                                 ToolTip="Mitte"        Checked="OnRktEigChanged"/>
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="RktBezugMR"
                                                 GroupName="RktBezug" Canvas.Left="73" Canvas.Top="25"
                                                 ToolTip="Rechts Mitte" Checked="OnRktEigChanged"/>
                                    <!-- Unten -->
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="RktBezugUL"
                                                 GroupName="RktBezug" Canvas.Left="3"  Canvas.Top="49"
                                                 IsChecked="True"
                                                 ToolTip="Unten links"  Checked="OnRktEigChanged"/>
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="RktBezugUM"
                                                 GroupName="RktBezug" Canvas.Left="38" Canvas.Top="49"
                                                 ToolTip="Unten Mitte"  Checked="OnRktEigChanged"/>
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="RktBezugUR"
                                                 GroupName="RktBezug" Canvas.Left="73" Canvas.Top="49"
                                                 ToolTip="Unten rechts" Checked="OnRktEigChanged"/>
                                </Canvas>

                                <!-- Breite / Höhe -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Breite (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RktEigBreite" LostFocus="OnRktEigLostFocus" KeyDown="OnRktEigKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Höhe (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RktEigHoehe" LostFocus="OnRktEigLostFocus" KeyDown="OnRktEigKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Z-Tiefe -->
                                <TextBlock Text="Z-Tiefe (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="RktEigZ" Margin="0,0,0,10"
                                         LostFocus="OnRktEigLostFocus" KeyDown="OnRktEigKeyDown"/>

                                <!-- Fräsung (nur Kontur-Modus) -->
                                <StackPanel x:Name="PnlRktFraesung">
                                    <TextBlock Text="Fräsung:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton x:Name="RktEigFrAussen" Content="Außen"
                                                     GroupName="RktFraesung" IsChecked="True"
                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Checked="OnRktEigChanged"/>
                                        <RadioButton x:Name="RktEigFrInnen"  Content="Innen"
                                                     GroupName="RktFraesung"
                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Checked="OnRktEigChanged"/>
                                        <RadioButton x:Name="RktEigFrMittig" Content="Mittig"
                                                     GroupName="RktFraesung"
                                                     VerticalAlignment="Center"
                                                     Checked="OnRktEigChanged"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Laufrichtung (nur Kontur-Modus) -->
                                <StackPanel x:Name="PnlRktLauf">
                                    <TextBlock Text="Laufrichtung:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton x:Name="RktEigGegen"  Content="Gegenlauf"
                                                     GroupName="RktLauf" IsChecked="True"
                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Checked="OnRktEigChanged"/>
                                        <RadioButton x:Name="RktEigGleich" Content="Gleichlauf"
                                                     GroupName="RktLauf"
                                                     VerticalAlignment="Center"
                                                     Checked="OnRktEigChanged"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Verrundung (nur Kontur-Modus) -->
                                <StackPanel x:Name="PnlRktVerrundung">
                                    <TextBlock Text="Verrundung (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="RktEigVer" Margin="0,0,0,10"
                                             LostFocus="OnRktEigLostFocus" KeyDown="OnRktEigKeyDown"/>
                                </StackPanel>

                                <!-- Z-Zustellung -->
                                <CheckBox x:Name="RktEigMehrfach" Content="Mehrfach-Zustellung"
                                          Margin="0,0,0,4"
                                          Checked="OnRktEigChanged" Unchecked="OnRktEigChanged"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Z-Zustellung (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RktEigZZust" LostFocus="OnRktEigLostFocus" KeyDown="OnRktEigKeyDown"/>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>

                            <!-- ── Kreis ── -->
                            <StackPanel x:Name="PnlKreis" Visibility="Collapsed">

                                <TextBlock Text="Kreis" FontWeight="Bold" FontSize="13"
                                           Margin="0,0,0,8"
                                           Foreground="{StaticResource TextDarkBrush}"/>

                                <!-- Modus: Kontur / Tasche -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="KrModusNut" Content="Kontur"
                                                 GroupName="KrModus" IsChecked="True"
                                                 Margin="0,0,12,0" VerticalAlignment="Center"
                                                 Checked="OnKrEigChanged"/>
                                    <RadioButton x:Name="KrModusTasche" Content="Tasche"
                                                 GroupName="KrModus"
                                                 VerticalAlignment="Center"
                                                 Checked="OnKrEigChanged"/>
                                </StackPanel>

                                <!-- X / Y -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="KrEigX" LostFocus="OnKrEigLostFocus" KeyDown="OnKrEigKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="KrEigY" LostFocus="OnKrEigLostFocus" KeyDown="OnKrEigKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Bezugspunkt -->
                                <TextBlock Text="Bezugspunkt:" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Canvas Width="90" Height="64" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <Rectangle Canvas.Left="10" Canvas.Top="8"
                                               Width="70" Height="48"
                                               Fill="#F5EFDA" Stroke="#C8A864"
                                               StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>
                                    <!-- Oben -->
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="KrBezugOL"
                                                 GroupName="KrBezug" Canvas.Left="3"  Canvas.Top="1"
                                                 ToolTip="Oben links"  Checked="OnKrEigChanged"/>
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="KrBezugOM"
                                                 GroupName="KrBezug" Canvas.Left="38" Canvas.Top="1"
                                                 ToolTip="Oben Mitte"  Checked="OnKrEigChanged"/>
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="KrBezugOR"
                                                 GroupName="KrBezug" Canvas.Left="73" Canvas.Top="1"
                                                 ToolTip="Oben rechts" Checked="OnKrEigChanged"/>
                                    <!-- Mitte -->
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="KrBezugML"
                                                 GroupName="KrBezug" Canvas.Left="3"  Canvas.Top="25"
                                                 ToolTip="Links Mitte"  Checked="OnKrEigChanged"/>
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="KrBezugMM"
                                                 GroupName="KrBezug" Canvas.Left="38" Canvas.Top="25"
                                                 IsChecked="True"
                                                 ToolTip="Mitte"        Checked="OnKrEigChanged"/>
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="KrBezugMR"
                                                 GroupName="KrBezug" Canvas.Left="73" Canvas.Top="25"
                                                 ToolTip="Rechts Mitte" Checked="OnKrEigChanged"/>
                                    <!-- Unten -->
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="KrBezugUL"
                                                 GroupName="KrBezug" Canvas.Left="3"  Canvas.Top="49"
                                                 ToolTip="Unten links"  Checked="OnKrEigChanged"/>
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="KrBezugUM"
                                                 GroupName="KrBezug" Canvas.Left="38" Canvas.Top="49"
                                                 ToolTip="Unten Mitte"  Checked="OnKrEigChanged"/>
                                    <RadioButton Style="{StaticResource BezugKompakt}" x:Name="KrBezugUR"
                                                 GroupName="KrBezug" Canvas.Left="73" Canvas.Top="49"
                                                 ToolTip="Unten rechts" Checked="OnKrEigChanged"/>
                                </Canvas>

                                <!-- Radius -->
                                <TextBlock Text="Radius (mm):" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                <TextBox x:Name="KrEigRadius" Margin="0,0,0,10"
                                         LostFocus="OnKrEigLostFocus" KeyDown="OnKrEigKeyDown"/>

                                <!-- Z-Tiefe -->
                                <TextBlock Text="Z-Tiefe (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="KrEigZ" Margin="0,0,0,10"
                                         LostFocus="OnKrEigLostFocus" KeyDown="OnKrEigKeyDown"/>

                                <!-- Fräsung (nur Kontur-Modus) -->
                                <StackPanel x:Name="PnlKrFraesung">
                                    <TextBlock Text="Fräsung:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton x:Name="KrEigFrAussen" Content="Außen"
                                                     GroupName="KrFraesung" IsChecked="True"
                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Checked="OnKrEigChanged"/>
                                        <RadioButton x:Name="KrEigFrInnen"  Content="Innen"
                                                     GroupName="KrFraesung"
                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Checked="OnKrEigChanged"/>
                                        <RadioButton x:Name="KrEigFrMittig" Content="Mittig"
                                                     GroupName="KrFraesung"
                                                     VerticalAlignment="Center"
                                                     Checked="OnKrEigChanged"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Laufrichtung -->
                                <TextBlock Text="Laufrichtung:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="KrEigGegen"  Content="Gegenlauf"
                                                 GroupName="KrLauf" IsChecked="True"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Checked="OnKrEigChanged"/>
                                    <RadioButton x:Name="KrEigGleich" Content="Gleichlauf"
                                                 GroupName="KrLauf"
                                                 VerticalAlignment="Center"
                                                 Checked="OnKrEigChanged"/>
                                </StackPanel>

                                <!-- Z-Zustellung -->
                                <CheckBox x:Name="KrEigMehrfach" Content="Mehrfach-Zustellung"
                                          Margin="0,0,0,4"
                                          Checked="OnKrEigChanged" Unchecked="OnKrEigChanged"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Z-Zustellung (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="KrEigZZust" LostFocus="OnKrEigLostFocus" KeyDown="OnKrEigKeyDown"/>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>

                            <!-- ── Reihenlochbohrung ── -->
                            <StackPanel x:Name="PnlReihenloch" Visibility="Collapsed">

                                <TextBlock Text="Reihenlochbohrung" FontWeight="Bold" FontSize="13"
                                           Margin="0,0,0,8"
                                           Foreground="{StaticResource TextDarkBrush}"/>

                                <!-- Lochabstand X / Y -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Lochabstand X (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RlbEigAbstandX" LostFocus="OnRlbEigLostFocus" KeyDown="OnRlbEigKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Lochabstand Y (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RlbEigAbstandY" LostFocus="OnRlbEigLostFocus" KeyDown="OnRlbEigKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Bohrtiefe -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bohrtiefe (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RlbEigTiefe" LostFocus="OnRlbEigLostFocus" KeyDown="OnRlbEigKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Bohrart: Kreistasche -->
                                <TextBlock Text="Bohrart:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="RlbEigKreistasche" Grid.Column="0" Content="Kreistasche"
                                              VerticalAlignment="Bottom" Margin="0,0,0,3"
                                              Checked="OnRlbEigChanged" Unchecked="OnRlbEigChanged"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Durchmesser (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RlbEigTascheD" IsEnabled="{Binding IsChecked, ElementName=RlbEigKreistasche}"
                                                 LostFocus="OnRlbEigLostFocus" KeyDown="OnRlbEigKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="In X-Richtung einmitten" Click="OnRlbEinmittenX"
                                            Padding="10,3" Margin="0,0,8,0"
                                            ToolTip="Lochreihe horizontal auf dem Werkstück zentrieren"/>
                                    <Button Content="In Y-Richtung einmitten" Click="OnRlbEinmittenY"
                                            Padding="10,3"
                                            ToolTip="Lochreihe vertikal auf dem Werkstück zentrieren"/>
                                </StackPanel>

                            </StackPanel>

                            <!-- ── N-Eck ── -->
                            <StackPanel x:Name="PnlNEck" Visibility="Collapsed">

                                <TextBlock Text="N-Eck" FontWeight="Bold" FontSize="13"
                                           Margin="0,0,0,8"
                                           Foreground="{StaticResource TextDarkBrush}"/>

                                <!-- Modus: Kontur / Tasche -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="NEckModusNut" Content="Kontur"
                                                 GroupName="NEckModus" IsChecked="True"
                                                 Margin="0,0,12,0" VerticalAlignment="Center"
                                                 Checked="OnNEckEigChanged"/>
                                    <RadioButton x:Name="NEckModusTasche" Content="Tasche"
                                                 GroupName="NEckModus"
                                                 VerticalAlignment="Center"
                                                 Checked="OnNEckEigChanged"/>
                                </StackPanel>

                                <!-- X / Y -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="NEckEigX" LostFocus="OnNEckEigLostFocus" KeyDown="OnNEckEigKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="NEckEigY" LostFocus="OnNEckEigLostFocus" KeyDown="OnNEckEigKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Ecken und Rotation -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Eckenzahl:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="NEckEigEcken" LostFocus="OnNEckEigLostFocus" KeyDown="OnNEckEigKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Rotation (°):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="NEckEigRotation" LostFocus="OnNEckEigLostFocus" KeyDown="OnNEckEigKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Radius -->
                                <TextBlock Text="Radius (mm):" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                <TextBox x:Name="NEckEigRadius" Margin="0,0,0,10"
                                         LostFocus="OnNEckEigLostFocus" KeyDown="OnNEckEigKeyDown"/>

                                <!-- Z-Tiefe -->
                                <TextBlock Text="Z-Tiefe (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="NEckEigZ" Margin="0,0,0,10"
                                         LostFocus="OnNEckEigLostFocus" KeyDown="OnNEckEigKeyDown"/>

                                <!-- Konturlinie (Fräsung) -->
                                <StackPanel x:Name="PnlNEckFraesung">
                                    <TextBlock Text="Konturlinie:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton x:Name="NEckEigFrAussen" Content="Außen"
                                                     GroupName="NEckFraesung" IsChecked="True"
                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Checked="OnNEckEigChanged"/>
                                        <RadioButton x:Name="NEckEigFrInnen"  Content="Innen"
                                                     GroupName="NEckFraesung"
                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Checked="OnNEckEigChanged"/>
                                        <RadioButton x:Name="NEckEigFrMittig" Content="Mittig"
                                                     GroupName="NEckFraesung"
                                                     VerticalAlignment="Center"
                                                     Checked="OnNEckEigChanged"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Radiuskorrektur -->
                                <TextBlock Text="Radiuskorrektur:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="NEckEigRadKorKeine" Content="Keine"
                                                 GroupName="NEckRadKor" IsChecked="True"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Checked="OnNEckEigChanged"/>
                                    <RadioButton x:Name="NEckEigRadKorInnen"  Content="Innen (G41)"
                                                 GroupName="NEckRadKor"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Checked="OnNEckEigChanged"/>
                                    <RadioButton x:Name="NEckEigRadKorAussen" Content="Außen (G42)"
                                                 GroupName="NEckRadKor"
                                                 VerticalAlignment="Center"
                                                 Checked="OnNEckEigChanged"/>
                                </StackPanel>

                                <!-- Laufrichtung -->
                                <TextBlock Text="Laufrichtung:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="NEckEigGegen"  Content="Gegenlauf"
                                                 GroupName="NEckLauf" IsChecked="True"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Checked="OnNEckEigChanged"/>
                                    <RadioButton x:Name="NEckEigGleich" Content="Gleichlauf"
                                                 GroupName="NEckLauf"
                                                 VerticalAlignment="Center"
                                                 Checked="OnNEckEigChanged"/>
                                </StackPanel>

                                <!-- Z-Zustellung -->
                                <CheckBox x:Name="NEckEigMehrfach" Content="Mehrfach-Zustellung"
                                          Margin="0,0,0,4"
                                          Checked="OnNEckEigChanged" Unchecked="OnNEckEigChanged"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Z-Zustellung (mm):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="NEckEigZZust" LostFocus="OnNEckEigLostFocus" KeyDown="OnNEckEigKeyDown"/>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 3: G-Code Editor -->
                <TabItem Header="G-Code" x:Name="TabGCode">
                    <avalon:TextEditor x:Name="GCodeBox"
                                       FontFamily="Consolas" FontSize="12"
                                       Background="{StaticResource BgLightBrush}"
                                       Foreground="{StaticResource TextDarkBrush}"
                                       ShowLineNumbers="True"
                                       WordWrap="False"
                                       IsReadOnly="False"
                                       Loaded="OnGCodeBoxLoaded"/>
                </TabItem>
            </TabControl>
        </Grid>
        </DockPanel>
    </Grid>
</Window>
